# PhishLens LLM API Keys (Person C)
# Add your preferred provider's API key below:

# 1. Anthropic Claude (recommended in build plan: Claude Haiku 5.5 / 3.5 Haiku)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 2. Google Gemini (e.g. gemini-2.0-flash or gemini-1.5-flash)
# GEMINI_API_KEY=your_gemini_api_key_here

# 3. OpenAI (e.g. gpt-4o-mini)
# OPENAI_API_KEY=your_openai_api_key_here

# 4. Groq (e.g. llama-3.1-8b-instant)
# GROQ_API_KEY=your_groq_api_key_here

